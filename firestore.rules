rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Gesperrte Konten dürfen nichts mehr anlegen oder ändern (zusätzlich wird das Login deaktiviert)
    function aktiv() { return signedIn() && !exists(/databases/$(database)/documents/kontosperren/$(request.auth.uid)); }
    function email() { return request.auth.token.email.lower(); }
    // Admin = Nils' Konto in projekt-fs (fest über die Nutzer-UID, nicht über die E-Mail)
    function isAdmin() { return signedIn() && request.auth.uid == '8Vm4gmz4WzbCMdHwZFsvsXYTIXP2'; }
    // Die ersten Konten: dürfen sich ohne Einladungscode ein Profil anlegen und die erste Karte "main" nutzen
    function legacy() { return signedIn() && email() in ['nilshrnr@icloud.com', 'fritz.samira.28.08@gmail.com']; }

    function kartePath(kid) { return /databases/$(database)/documents/karten/$(kid); }
    function mitgliedPath(kid, uid) { return /databases/$(database)/documents/karten/$(kid)/mitglieder/$(uid); }
    function linkPath(code) { return /databases/$(database)/documents/kartenEinladungen/$(code); }
    function member(kid) { return signedIn() && exists(mitgliedPath(kid, request.auth.uid)); }
    function ownerOf(kid) { return signedIn() && get(kartePath(kid)).data.owner == request.auth.uid; }
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 40; }
    function pubOk() {
      let n = request.resource.data;
      return !('pub' in n) || n.pub == null || n.pub == request.auth.uid
        || (resource != null && 'pub' in resource.data && resource.data.pub == n.pub);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['name', 'bio', 'photo', 'code', 'link', 'einwilligung', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 40
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 300))
        && (!('photo' in d) || (d.photo is string && d.photo.size() <= 200000));
    }
    // Einwilligung (Art. 7 DSGVO): Textversion + Zeitpunkt, Zeitpunkt kommt immer vom Server
    function validConsent(e) {
      return e is map && e.keys().hasOnly(['version', 'at'])
        && e.version is string && e.version.size() >= 1 && e.version.size() <= 20
        && e.at == request.time;
    }
    function validRequest(d) {
      return d.keys().hasOnly(['email', 'createdAt', 'status'])
        && d.email is string && d.email.size() >= 6 && d.email.size() <= 120
        && d.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && d.createdAt == request.time;
    }

    // ---------- Karten ----------
    match /karten/{kid} {
      allow read: if member(kid) || (kid == 'main' && legacy());
      allow create: if aktiv()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && validName(request.resource.data.name)
        && (kid != 'main' || legacy());
      allow update: if ownerOf(kid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
      allow delete: if ownerOf(kid);

      // Spots: alle Mitglieder dürfen lesen und schreiben
      // pub = UID der Person, die den Spot öffentlich geteilt hat – setzen darf man nur sich selbst
      match /pins/{pin} {
        allow read, delete: if member(kid) || (kid == 'main' && legacy());
        allow create, update: if (member(kid) || (kid == 'main' && legacy())) && pubOk() && aktiv();
      }

      // Mitglieder: Dokument-ID = Nutzer-UID
      match /mitglieder/{uid} {
        allow read: if member(kid) || (kid == 'main' && legacy());
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'rolle', 'via', 'joinedAt'])
          && request.resource.data.uid == uid
          && validName(request.resource.data.name)
          && (request.resource.data.rolle == 'member' || getAfter(kartePath(kid)).data.owner == uid)
          && (
            getAfter(kartePath(kid)).data.owner == uid                    // wer die Karte anlegt
            || (kid == 'main' && legacy())                                // die ersten Konten
            || (request.resource.data.via is string                       // mit Partner-Code
                && get(linkPath(request.resource.data.via)).data.karte == kid
                && get(linkPath(request.resource.data.via)).data.usedBy == null
                && getAfter(linkPath(request.resource.data.via)).data.usedBy == uid)
          );
        allow update: if signedIn() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && validName(request.resource.data.name);
        allow delete: if signedIn() && (uid == request.auth.uid || ownerOf(kid));
      }
    }

    // Partner-Codes für eine Karte: Dokument-ID = der Code (8 Zeichen)
    match /kartenEinladungen/{code} {
      allow get: if true;                                              // Code prüfen, auch vor der Registrierung
      allow list: if signedIn() && resource.data.by == request.auth.uid;
      allow create: if aktiv() && code.size() == 8
        && request.resource.data.keys().hasOnly(['karte', 'kartenName', 'by', 'byName', 'createdAt', 'usedBy'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.usedBy == null
        && member(request.resource.data.karte)
        && !exists(/databases/$(database)/documents/einladungen/$(code));
      allow delete: if signedIn() && (resource.data.by == request.auth.uid || ownerOf(resource.data.karte));
      // Einlösen: nur einmal, nur für sich selbst, nur zusammen mit der eigenen Mitgliedschaft
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(mitgliedPath(resource.data.karte, request.auth.uid)).data.via == code;
    }

    // ---------- Zugang (Einladungscodes vom Server) ----------
    match /anfragen/{id} {
      allow create: if validRequest(request.resource.data)
        && (request.resource.data.status == 'neu' || (isAdmin() && request.resource.data.status == 'freigegeben'));
      allow read, update, delete: if isAdmin();
    }
    match /einstellungen/{doc} {
      allow read, write: if isAdmin();
    }
    match /einladungen/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow delete: if isAdmin() && resource.data.usedBy == null;
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/nutzer/$(request.auth.uid)).data.code == code;
    }

    // ---------- Öffentliche Karte (schreibt nur der Server) ----------
    match /orte/{oid} {
      allow read: if signedIn();
      allow delete: if isAdmin();
    }
    match /oeffentlich/{eid} {
      allow read: if signedIn();
      allow delete: if isAdmin();
    }
    match /profile/{uid} {
      allow read: if signedIn();
    }
    match /gesperrt/{eid} {
      allow read, write: if isAdmin();
    }
    match /kontosperren/{uid} {
      allow read, write: if isAdmin();
    }
    match /meldungen/{id} {
      // Meldung ohne Konto über /melden/ (DSA Art. 16): nur diese Felder, alles mit Längenlimit
      allow create: if request.resource.data.keys().hasOnly(['quelle', 'was', 'text', 'name', 'email', 'gutglaube', 'grund', 'createdAt', 'status'])
        && request.resource.data.quelle == 'extern'
        && request.resource.data.grund == 'extern'
        && request.resource.data.status == 'offen'
        && request.resource.data.createdAt == request.time
        && request.resource.data.gutglaube == true
        && request.resource.data.was is string && request.resource.data.was.size() >= 3 && request.resource.data.was.size() <= 500
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 2000
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120;
      allow create: if aktiv()
        && request.resource.data.keys().hasOnly(['ort', 'eintrag', 'grund', 'text', 'by', 'createdAt', 'status'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'offen'
        && request.resource.data.ort is string && request.resource.data.ort.size() >= 1 && request.resource.data.ort.size() <= 40
        && (request.resource.data.eintrag == null || (request.resource.data.eintrag is string && request.resource.data.eintrag.size() <= 40))
        && request.resource.data.grund in ['person', 'privat', 'illegal', 'beleidigend', 'falsch', 'sonstiges']
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow read, update, delete: if isAdmin();
    }

    // ---------- Profile ----------
    match /nutzer/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && 'einwilligung' in request.resource.data && validConsent(request.resource.data.einwilligung)
        && (
          (legacy() && !('code' in request.resource.data) && !('link' in request.resource.data))
          || (request.resource.data.code is string
              && get(/databases/$(database)/documents/einladungen/$(request.resource.data.code)).data.usedBy == null
              && getAfter(/databases/$(database)/documents/einladungen/$(request.resource.data.code)).data.usedBy == uid)
          || (request.resource.data.link is string
              && get(linkPath(request.resource.data.link)).data.usedBy == null
              && getAfter(linkPath(request.resource.data.link)).data.usedBy == uid)
        );
      allow update: if aktiv() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'photo', 'updatedAt', 'einwilligung'])
        && (!('einwilligung' in request.resource.data.diff(resource.data).affectedKeys())
            || (validConsent(request.resource.data.einwilligung)
                && (!('einwilligung' in resource.data) || resource.data.einwilligung.version != request.resource.data.einwilligung.version)));
      allow delete: if signedIn() && request.auth.uid == uid;

      // Liste der eigenen Karten (nur für einen selbst)
      match /meineKarten/{kid} {
        allow read: if signedIn() && uid == request.auth.uid;
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
          && validName(request.resource.data.name)
          && existsAfter(mitgliedPath(kid, uid));
        allow delete: if signedIn() && uid == request.auth.uid;
      }
    }
  }
}
